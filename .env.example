# Quipus application URL and regional defaults
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kuala_Lumpur

# Supabase: use a publishable key in the browser and a secret key on the server.
# SUPABASE_SERVICE_ROLE_KEY accepts either a modern sb_secret_ key or the legacy
# service_role key. Never expose this server value through NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI transcription, meeting extraction, Quipus Relay, and device speech
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_RELAY_MODEL=gpt-5.4-mini
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=cedar

# Google Calendar OAuth. Each user connects Calendar from their own dashboard;
# Quipus encrypts and stores that user's refresh token in Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CALENDAR_ID=primary
# Also protects the device's archive-key backup; keep it stable across deployments.
ACTION_APPROVAL_SECRET=

# Durable recording/report worker: same random 32+ character secret on Railway.
PROCESSING_WORKER_SECRET=
# Serverless Redis REST credentials publish processing progress and wakeups.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Prototype WhatsApp relay: Supabase auth user UUID permitted to manage it.
WHATSAPP_OWNER_USER_ID=
WHATSAPP_RELAY_URL=
WHATSAPP_RELAY_TOKEN=
WHATSAPP_ALLOWED_RECIPIENT=601154444038

# Agora wearable audio and Speech-to-Text
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_STT_LANGUAGES=ms-MY,en-SG
AGORA_STT_KEYWORDS=Quipus,Malaysia,ringgit

# Optional event research for Quipus Relay
EXA_API_KEY=
RELAY_EVENT_NAME=AITKL · Agents, Everywhere
RELAY_EVENT_VENUE=WORQ Bangsar

# Migration switch: keep inline until migration013 and dedicated Railway service are healthy.
# Then set dedicated to keep audio processing out of Vercel request lifetimes.
QUIPUS_PROCESSING_MODE=inline

# Audio-retention maintenance only: separate random 32+ byte server secret.
RECORDING_RETENTION_SECRET=
