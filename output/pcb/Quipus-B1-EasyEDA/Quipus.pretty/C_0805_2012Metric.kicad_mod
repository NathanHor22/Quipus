      (font
        (size 1 1)
        (thickness 0.15))))
  (fp_text value "C_0805_2012Metric"
    (at 0 1.68 0)
    (layer "F.Fab")
    (effects
      (font
        (size 1 1)
        (thickness 0.15))))
