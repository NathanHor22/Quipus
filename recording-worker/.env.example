# Separate Railway service, repository root directory (not worker/).
# No Google, Agora, or WhatsApp credentials are required by this process.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
EXA_API_KEY=
APP_TIMEZONE=Asia/Kuala_Lumpur
# Native TLS connection to the SAME Upstash database used by Vercel.
UPSTASH_REDIS_URL=
# Optional REST credentials for short-lived progress and public-company caches.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RECORDING_WORKER_CONCURRENCY=1
RECORDING_WORKER_POLL_MS=10000
RECORDING_WORKER_SHUTDOWN_MS=30000
HOST=0.0.0.0
# Railway injects PORT; local default is 3002.
